{
  "name": "temp-mail",
  "type": "module",
  "version": "0.1.1",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy --minify",
    "tail": "wrangler tail",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create temp-mail-d1",
    "db:tables": "wrangler d1 execute temp-mail-d1 --file ./sql/schema.sql --remote",
    "db:indexes": "wrangler d1 execute temp-mail-d1 --file ./sql/indexes.sql --remote",
    "kv:create": "wrangler kv namespace create temp-mail-kv --preview",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write --unsafe ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write --unsafe ./src",
    "build": "tsc --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@grammyjs/commands": "^1.4.0",
    "@grammyjs/menu": "^1.5.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@scalar/hono-api-reference": "^0.12.9",
    "grammy": "^1.46.0",
    "hono": "^4.13.12",
    "html-to-text": "^10.0.1",
    "postal-mime": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.4",
    "knip": "^6.39.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.146.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
