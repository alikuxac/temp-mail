# =============================================================================
# Cloudflare Worker secrets (/ secrets via `wrangler secret put <NAME>`)
# Never commit real values. Public config belongs in `wrangler.jsonc` -> "vars".
# =============================================================================

# Telegram
TELEGRAM_TOKEN=
# Comma separated Telegram user / chat IDs allowed to use admin commands.
# The owner ID is also granted an unlimited quota (no max address / rate limit).
ADMIN_ID=

# Mail domains
DOMAIN=
WORKER_DOMAIN=

# Outbound mail (Resend)
RESEND_API_KEY=
# Comma separated extra domains verified on Resend (sender header allowlist).
RESEND_ALLOWED_DOMAINS=

# Telegram Mini App
MINI_APP_URL=
# Deep link opened by the Mini App "Open in Discord" button.
DISCORD_ACTIVITY_URL=

# Discord Activity
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Playground/demo endpoint, only used when Wrangler dev sends a placeholder token.
# Example: https://xxxx-xxx.trycloudflare.com
DISCORD_OAUTH_PROXY_URL=
# Comma separated Discord user snowflakes allowed to use the Activity.
# Empty/absent => deny everyone (deny-by-default).
ALLOWED_DISCORD_USER_IDS=
# Allow whoever installed the Activity (`scope = applications.commands.permissions.update`)
# in addition to ALLOWED_DISCORD_USER_IDS.
DISCORD_ALLOW_INSTALLER=false
# Optional guild allowlist (Comma separated guild snowflakes). Empty => any guild.
ALLOWED_DISCORD_GUILD_IDS=

# AI summarization (optional). Defaults keep using the Workers AI binding.
# Set AI_PROVIDER to choose explicitly: workers-ai | openai-compatible.
AI_PROVIDER=
# Workers AI model id (default @cf/meta/llama-3-8b-instruct)
AI_MODEL=
# OpenAI-compatible endpoint (DeepSeek default: https://api.deepseek.com/v1)
AI_BASE_URL=
# API key for the OpenAI-compatible provider. Setting it enables that provider.
AI_API_KEY=
AI_MAX_TOKENS=100
AI_TEMPERATURE=0.3

# Quotas
MAX_ADDRESSES_PER_USER=
RATE_LIMIT_SECONDS=